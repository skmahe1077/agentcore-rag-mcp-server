# Local-development environment variables for running the agent or MCP
# tools outside AWS (e.g. `python -m app.mcp_server.server`, or driving
# app/agent/main.py's invoke_agent() directly against a deployed Gateway).
#
# In deployed AWS, these are set automatically by Terraform
# (terraform/lambda-tools.tf and terraform/agentcore.tf) - you do not need
# this file to deploy or run make targets. Copy to .env and `source` it
# (or use direnv) only for local development.
#
# Never commit a real .env file - it is gitignored.

AWS_REGION=eu-west-1

# --- MCP tools (app/mcp_server) ---
TABLE_NAME=
KNOWLEDGE_BASE_ID=
USE_SIMULATED_OPERATIONAL_DATA=true
ENABLE_LIVE_AWS_DIAGNOSTICS=false
RETRIEVAL_RESULTS=4
MAX_RETRIEVAL_RESULTS_CAP=10
ENABLE_DEBUG_LOGGING=false

# --- Agent (app/agent) ---
FOUNDATION_MODEL_ID=
MAX_OUTPUT_TOKENS=1200
MAXIMUM_TOOL_CALLS=8
MAXIMUM_AGENT_STEPS=10
GATEWAY_URL=
COGNITO_DISCOVERY_URL=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
TRACE_SAMPLING_PERCENTAGE=10

# Optional Bedrock Guardrails - leave both empty to disable
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
